# =============================================================================
# Multi-Factor Authentication System - environment configuration TEMPLATE
#
# Copy this file to ".env" and fill in real values:
#     cp .env.example .env         (Linux/macOS)
#     copy .env.example .env       (Windows)
#
# .env is listed in .gitignore and must NEVER be committed to version control.
# Every value below is a placeholder. No real secret appears in this file.
# =============================================================================

# -----------------------------------------------------------------------------
# Which configuration class to load: development | testing | production
# -----------------------------------------------------------------------------
FLASK_CONFIG=development

# -----------------------------------------------------------------------------
# REQUIRED SECRETS
#
# Generate both values with:
#     flask --app wsgi generate-keys
#
# Or individually:
#     python -c "import secrets; print(secrets.token_hex(32))"
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# SECRET_KEY        signs the session cookie.
# MFA_ENCRYPTION_KEY encrypts TOTP secrets at rest. If this key is lost, every
#                    enrolled user must re-enroll, so back it up separately
#                    from the database.
# -----------------------------------------------------------------------------
SECRET_KEY=replace-with-64-hex-characters-from-the-command-above
MFA_ENCRYPTION_KEY=replace-with-a-fernet-key-from-the-command-above

# -----------------------------------------------------------------------------
# MYSQL DATABASE
#
# Create the database and a least-privilege account first; see
# docs/DEPLOYMENT.md section 3 for the exact SQL.
# -----------------------------------------------------------------------------
MYSQL_USER=mfa_user
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=mfa_db

# Optional: set DATABASE_URL to override the assembled MySQL URI entirely.
# DATABASE_URL=mysql+pymysql://mfa_user:password@localhost:3306/mfa_db?charset=utf8mb4

# Optional: a MySQL URL used by the test suite instead of in-memory SQLite.
# The named database is created and dropped by the tests, so point it at a
# throwaway database only.
# MFA_TEST_DATABASE_URL=mysql+pymysql://mfa_user:password@localhost:3306/mfa_test_db?charset=utf8mb4

# -----------------------------------------------------------------------------
# SESSION AND COOKIES
#
# SESSION_COOKIE_SECURE must be true in production, which requires HTTPS.
# Leaving it true on plain HTTP will stop the cookie being sent at all, so it
# is false by default for local development.
# -----------------------------------------------------------------------------
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_MINUTES=30
SESSION_IDLE_TIMEOUT_MINUTES=15

# Set to true only when running behind a reverse proxy you control (nginx,
# Apache), so that X-Forwarded-For is trusted for audit logging and rate limits.
TRUST_PROXY_HEADERS=false

# -----------------------------------------------------------------------------
# MFA BEHAVIOUR
# -----------------------------------------------------------------------------
MFA_ISSUER_NAME=ISBAT MFA Demo
TOTP_DIGITS=6
TOTP_INTERVAL=30
# Steps of clock skew accepted either side of now. 1 => about a 90-second window.
TOTP_VALID_WINDOW=1
# Lifetime of the "password accepted, awaiting code" state, in seconds.
MFA_PENDING_TTL_SECONDS=300
MFA_PENDING_MAX_ATTEMPTS=5
RECOVERY_CODE_COUNT=10

# -----------------------------------------------------------------------------
# PASSWORD POLICY AND LOCKOUT
# -----------------------------------------------------------------------------
PASSWORD_MIN_LENGTH=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30

# -----------------------------------------------------------------------------
# ARGON2ID COST PARAMETERS
#
# Defaults follow OWASP guidance (64 MiB memory, 3 iterations, 2 lanes).
# Raise ARGON2_MEMORY_COST on a server with spare RAM; lower it only if the
# hashing time becomes unacceptable on your hardware, and say so in the report.
# -----------------------------------------------------------------------------
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2

# -----------------------------------------------------------------------------
# RATE LIMITING
#
# "memory://" is per-process and resets on restart, which is fine for a single
# development server. For multiple workers use a shared store, for example:
#     RATELIMIT_STORAGE_URI=redis://localhost:6379/0
# -----------------------------------------------------------------------------
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_LOGIN=10 per minute
RATELIMIT_MFA=10 per minute
RATELIMIT_REGISTER=5 per minute
RATELIMIT_RESET=5 per minute

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_DIR=logs

# -----------------------------------------------------------------------------
# OPTIONAL: used only by "flask create-admin" so the password is not typed in
# a shell that records history. Remove it from .env once the admin exists.
# -----------------------------------------------------------------------------
# ADMIN_PASSWORD=
